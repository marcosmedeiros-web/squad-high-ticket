# Perfil do e-mail marketing. Copie para fora do pacote (ex.: ~/email-perfil/email.env), preencha e confira:
#   EMK_PERFIL=~/email-perfil/email.env python3 motor/email_mkt.py perfil conferir
# Valor que ainda tem cara de exemplo (<...>, PREENCHER, seudominio) e recusado. Nenhuma credencial vai aqui:
# este arquivo so aponta para os arquivos do cofre (permissao 600).

# Servico de envio: resend (padrao do pacote) | ses | sendgrid. Com o Resend, a regua de copy e GUARDA DO ENVIO: texto
# com promessa de ganho nao sai (a politica dele proibe "get rich quick"; ver references/esp-politicas.md).
EMK_ESP=resend
# Reservas, em ordem, para quando o Resend recusar ou cortar a conta: email-mkt envio recuar (com OK do dono).
# Deixe a credencial da reserva no mesmo cofre (SES_SMTP_USUARIO/SES_SMTP_SENHA e/ou SENDGRID_API_KEY).
EMK_ESP_RESERVA=ses,sendgrid
EMK_SES_REGIAO=sa-east-1
# So no SES: os 3 tokens do Easy DKIM, separados por virgula (aparecem na tela da identidade do dominio).
EMK_SES_DKIM_TOKENS=PREENCHER
# Subdominio de retorno (MAIL FROM). No Resend o padrao e "send"; no SES so se voce configurou um.
EMK_MAILFROM_SUBDOMINIO=

# seco = so confere, nada sai | canario = so o e-mail para o contato do dono | lista = segmento, atras da guarda
EMK_MODO=seco
EMK_LOTE_PILOTO=5

# Enderecos
EMK_DOMINIO_MAUTIC=email.seudominio.com.br
EMK_API_URL=https://email.seudominio.com.br
EMK_DOMINIO_REMETENTE=seudominio.com.br
# endereco do remetente, no dominio acima (ex.: o contato da empresa)
EMK_REMETENTE=PREENCHER

# Rodape legal: o texto EXATO tem que estar no HTML de todo e-mail de segmento (as tres politicas pedem
# identificacao e endereco fisico; o plano do disparo recusa sem).
EMK_EMPRESA_NOME=PREENCHER
EMK_EMPRESA_ENDERECO=PREENCHER

# Id do SEU contato no Mautic (o canario: recebe cada e-mail antes de todo mundo)
EMK_CANARIO_CONTATO_ID=PREENCHER

# Cofre (arquivos 600, fora do pacote). Formato KEY=VALOR.
#   chave do servico: RESEND_API_KEY=... | SENDGRID_API_KEY=... | SES_SMTP_USUARIO=... e SES_SMTP_SENHA=...
#   API do Mautic:    MAUTIC_API_USUARIO=... e MAUTIC_API_SENHA=...
EMK_CHAVE_ARQUIVO=~/.config/email-marketing/cofre/envio.env
EMK_API_ARQUIVO=~/.config/email-marketing/cofre/mautic-api.env

# Containers (rode "email-mkt descobrir" para preencher)
EMK_DOCKER=docker
EMK_CT_WEB=PREENCHER
EMK_CT_CRON=PREENCHER
EMK_CT_WORKER=PREENCHER
EMK_CT_DB=PREENCHER
EMK_COMPOSE_DIR=PREENCHER
EMK_COMPOSE_CMD=docker compose
EMK_SERVICO_DB=PREENCHER
EMK_SERVICOS_MAUTIC=PREENCHER

# Estado local, avisos e vigias
EMK_ESTADO_DIR=~/.local/share/email-marketing
# arquivo = grava em <estado>/avisos.jsonl ; comando:/caminho/script = entrega o aviso (JSON) no stdin do script
EMK_AVISO_CANAL=arquivo
EMK_DISCO_ALERTA_PCT=85
EMK_DISCO_URGENTE_PCT=92
EMK_DISCO_CRESCIMENTO_GB_30MIN=5
# Validade do selo do HTTPS, em horas (a guarda tambem mede ao vivo antes de cada envio)
EMK_SELO_VALIDADE_H=168
