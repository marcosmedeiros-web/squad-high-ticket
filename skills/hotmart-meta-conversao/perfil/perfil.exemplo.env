# perfil.env do receptor Hotmart + API de Conversões da Meta. Copie para uma pasta SUA, fora do pacote
# (ex.: ~/hotmart-meta-perfil/perfil.env), e troque cada PREENCHER. Campo com PREENCHER recusa a instalação.
# Comentário no fim da linha precisa de um espaço antes do #.

# ---- receptor ---------------------------------------------------------------------------------------------
# pasta do banco local, caminho absoluto, fora do pacote (ex.: a pasta do perfil + /dados)
HM_DADOS_DIR=PREENCHER
# arquivo 600 com a linha HOTMART_HOTTOK=<hottok da aba Autenticação do Webhook da Hotmart>
HM_HOTTOK_ARQUIVO=PREENCHER
# porta local; o HTTPS público é do proxy (ver unidades/Caddyfile.exemplo)
HM_PORTA=8787
HM_ESCUTA=127.0.0.1
# ids dos produtos aceitos, separados por vírgula; vazio = todos
HM_PRODUTOS=
# depois disso o contato do carrinho abandonado é apagado
HM_RETENCAO_CONTATO_DIAS=30
# 1 = o IP do visitante vem do X-Forwarded-For posto pelo proxy local
HM_CONFIA_PROXY=1
# https://seusite.com.br,https://www.seusite.com.br (obrigatório com CAPI_CHECKOUT=kit)
HM_SITE_ORIGENS=
# arquivo:/caminho/avisos.jsonl ou comando:/caminho/script (avisos do vigia)
HM_AVISO_CANAL=

# ---- o que o pixel da Hotmart JÁ faz (Ferramentas > Pixel de Rastreamento > produto > Facebook + Instagram) --
# Responda olhando o painel. Não tem padrão de propósito: errar aqui conta venda em dobro na Meta.
# ligado | desligado  ("Vendas realizadas" marcado no pixel da Hotmart?)
HOTMART_PIXEL_NATIVO_COMPRA=PREENCHER
# ligado | desligado  ("Visitas na página de pagamento" marcado?)
HOTMART_PIXEL_NATIVO_CHECKOUT=PREENCHER

# ---- API de Conversões ------------------------------------------------------------------------------------
# seco (não chama a Meta) | teste (com test_event_code) | real
CAPI_MODO=seco
# kit | desligado   (kit só é aceito com HOTMART_PIXEL_NATIVO_COMPRA=desligado)
CAPI_PURCHASE=desligado
# kit | desligado   (o clique de checkout do site, com event_id igual ao do pixel)
CAPI_CHECKOUT=desligado
# id do conjunto de dados (pixel), só dígitos; obrigatório fora do seco
CAPI_PIXEL_ID=
# arquivo 600 com a linha META_CAPI_TOKEN=<token gerado no Gerenciador de Eventos>
CAPI_TOKEN_ARQUIVO=
# o código da aba "Testar eventos"; obrigatório no teste, proibido no real
CAPI_TEST_EVENT_CODE=
CAPI_VERSAO_GRAPH=v25.0
# preco (valor da oferta) | cheio (o que o comprador pagou, com juros)
CAPI_VALOR=preco
# primeira (só a 1a cobrança vira Purchase) | todas
CAPI_RECORRENCIA=primeira
# desligado | personalizado (manda o evento CarrinhoAbandonado; não é evento padrão da Meta)
CAPI_ABANDONO=desligado
# https://... página de vendas, usada quando a compra não tem clique registrado
CAPI_URL_PADRAO=
# action_source da compra sem clique registrado: other | system_generated | website
CAPI_ORIGEM_SEM_NAVEGADOR=other
# vazio = InitiateCheckout, ou CliqueCheckout quando o pixel da Hotmart já manda o checkout
SITE_EVENTO_CLIQUE=

# ---- vigia (plano B) --------------------------------------------------------------------------------------
# opcional: arquivo 600 com HOTMART_CLIENT_ID, HOTMART_CLIENT_SECRET e HOTMART_BASIC (credencial da API da Hotmart)
HM_HOTMART_CRED_ARQUIVO=
VIGIA_JANELA_HORAS=48
VIGIA_TOLERANCIA_MIN=30
# >0 avisa quando passar esse tempo sem nenhum evento (útil em semana de lançamento)
VIGIA_SILENCIO_HORAS=0
