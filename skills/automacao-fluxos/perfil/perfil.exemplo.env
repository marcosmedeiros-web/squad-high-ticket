# perfil.env do motor de automação. Copie para uma pasta SUA, fora do pacote (ex.: ~/automacao-perfil/perfil.env),
# e troque cada PREENCHER. Campo com PREENCHER recusa a instalação. Comentário no fim da linha: um espaço antes do #.

# ---- o essencial -------------------------------------------------------------------------------------------
# pasta do banco local e do estado (700), caminho absoluto, fora do pacote e fora de ~/.claude/skills
AF_DADOS_DIR=PREENCHER
# pasta com os desenhos dos fluxos (um <nome>.json por fluxo, copiados de modelos/ e preenchidos)
AF_FLUXOS_DIR=PREENCHER
# o endereço público com HTTPS que o Caddy do servidor manda para o receptor (ex.: https://automacao.seu-dominio)
AF_URL_PUBLICA=PREENCHER
# porta local do receptor (só 127.0.0.1)
AF_PORTA=8790
# fuso do horário comercial (Brasil sem horário de verão: -3)
AF_FUSO_UTC=-3

# ---- alarme -------------------------------------------------------------------------------------------------
# arquivo (padrão: grava em <dados>/avisos.jsonl) | comando:/caminho/script (o seu notificador: Telegram, e-mail, Slack;
# recebe o texto do alarme como 1º argumento e devolve rc 0 quando entregou)
AF_AVISO_CANAL=arquivo

# ---- Mautic (só se algum fluxo usa) -------------------------------------------------------------------------
# https://... do Mautic do dono (o mesmo do pacote de e-mail)
AF_MAUTIC_URL=
# arquivo 600 com MAUTIC_API_USUARIO=... e MAUTIC_API_SENHA=... (usuário de API do Mautic)
AF_MAUTIC_CRED_ARQUIVO=

# ---- WhatsApp pelo OpenWA na sua VPS (só se algum fluxo usa) -----------------------------------------------------
# só local: http://127.0.0.1:<porta>/api
AF_OPENWA_BASE=
# o id (uuid) da sessão do número que vai escrever
AF_OPENWA_SESSAO_ID=
# arquivo 600 com OPENWA_CHAVE=... (chave de papel operator, escopada só a esta sessão)
AF_OPENWA_CHAVE_ARQUIVO=
# horário em que WhatsApp individual pode sair (fora dele, espera)
AF_JANELA_INICIO=8
AF_JANELA_FIM=21
# teto de WhatsApp individual por dia, somando todos os fluxos
AF_TETO_WHATSAPP_DIA=60

# ---- Hotmart (só se usa o fluxo de venda) -------------------------------------------------------------------
# arquivo 600 com HOTMART_HOTTOK=... (aba Autenticação do Webhook da Hotmart)
AF_HOTMART_HOTTOK_ARQUIVO=

# ---- outros -------------------------------------------------------------------------------------------------
# dias até o e-mail, o telefone e o texto saírem do banco local
AF_RETENCAO_DIAS=30
# segundos esperando a releitura confirmar o WhatsApp
AF_CONFIRMAR_S=60
