[Unit]
Description=automacao-fluxos: receptor dos fluxos (127.0.0.1, atrás do Caddy)
After=network-online.target

[Service]
Type=simple
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/env python3 -B @SKILL@/motor/fluxos.py --perfil @PERFIL@ receptor
Restart=always
RestartSec=5
NoNewPrivileges=yes
UMask=0077

[Install]
WantedBy=default.target
